				{
					"name": "Create Post",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set(\"post_id\", jsonData.data.id);",
									"}"
								],
								"type": "javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"A Trip to the Mountains\",\n    \"description\": \"Had a wonderful trekking weekend. The view was breath-taking!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/posts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"posts"
							]
						},
						"description": "Create a new post. Automatically captures the created post ID in the `post_id` collection variable."
					},
					"response": []
				},
				{
					"name": "Show Post",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/v1/posts/{{post_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"posts",
								"{{post_id}}"
							]
						},
						"description": "Fetch a single post details by ID."
					},
					"response": []
				},
				{
					"name": "Update Post",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Updated Mountain Post Title\",\n    \"description\": \"Updated description text for my trekking post.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/posts/{{post_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"posts",
								"{{post_id}}"
							]
						},
						"description": "Update post details. Only the author of the post can perform this action."
					},
					"response": []
				},
				{
					"name": "Delete Post",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/v1/posts/{{post_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"posts",
								"{{post_id}}"
							]
						},
						"description": "Delete a post. Only the author of the post can perform this action."
					},
					"response": []
