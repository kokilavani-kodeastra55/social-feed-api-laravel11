{
	"info": {
		"_postman_id": "c1387d84-c812-4ebc-b3a1-2da5b81b2ca6",
		"name": "Social Feed API",
		"description": "Postman collection for testing the Laravel 11 Social Feed API including login/logout, posts, nested comments, polymorphic likes, and chronological/ranked feeds.",
